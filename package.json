{
  "name": "planrepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.client.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build --config vite.config.ts",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "test:smoke": "npm run build:server && node --test tests/core.smoke.test.mjs",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.2",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.6"
  }
}
